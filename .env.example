# ParakeetAI-Inspired Interview Assistant Environment Configuration
# Copy this file to .env.local to configure external live AI and Speech services.
# NOTE: The application is designed to be 100% functional out-of-the-box with its
# built-in Smart Domain Engine and Web Speech STT even if NO API keys are provided.

# Optional: Groq API Key for ultra-fast Llama-3.3-70b response generation (free tier at console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Optional: OpenAI API Key for GPT-4o and Whisper transcription
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Anthropic API Key for Claude 3.5 Sonnet live response generation
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Deepgram API Key for cloud-side real-time streaming speech-to-text
# Used by /api/transcribe for meeting/tab audio stream transcription
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# Application Port (default 3000)
PORT=3000
