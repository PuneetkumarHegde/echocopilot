# EchoCopilot Free Cloud & Local Environment Configuration
# Copy this file to .env.local to configure external live AI and Speech services.
# NOTE: The application is designed to be 100% functional out-of-the-box with its
# built-in Smart Domain Engine and Web Speech STT even if NO API keys are provided.

# 1. 100% Free Cloud AI & Speech: Groq Llama 3.3 70B & Whisper (Get free key at https://console.groq.com)
GROQ_API_KEY=

# 2. Local Ollama (or Cloudflare Tunnel URL when hosted)
OLLAMA_API_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# 3. Optional Cloud AI Services:
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=

# Application Port (default 3000)
PORT=3000
